{
 "kind": "trap",
 "layout": "dlist",
 "mutation": "semantic_swap",
 "recipe": {
  "record_selector": "div.agenda > dl.event",
  "fields": {
   "id": "::attr(data-id)",
   "title": "dd.name::text",
   "performer": "dd.cast::text",
   "starts_at": "dd.when::text",
   "price": "dd.cost::text",
   "url": "a.buy::attr(href)"
  }
 },
 "correct_recipe": {
  "record_selector": "div.agenda > dl.event",
  "fields": {
   "id": "::attr(data-id)",
   "title": "dd.meta:nth-of-type(2)::text",
   "performer": "dd.meta:nth-of-type(1)::text",
   "starts_at": "dd.when::text",
   "price": "dd.cost::text",
   "url": "a.buy::attr(href)"
  }
 }
}
