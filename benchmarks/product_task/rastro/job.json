{
  "format_version": 1,
  "dataset": {
    "name": "agenda",
    "path": "agenda.sqlite",
    "identity": [
      "performance_id"
    ]
  },
  "repair": {
    "auto_promote": true
  },
  "fields": [
    {
      "name": "performance_id",
      "type": "string",
      "min_length": 1
    },
    {
      "name": "title",
      "type": "string",
      "min_length": 1
    },
    {
      "name": "performers",
      "type": "string",
      "min_length": 1
    },
    {
      "name": "venue",
      "type": "string",
      "min_length": 1
    },
    {
      "name": "city",
      "type": "string",
      "min_length": 1
    },
    {
      "name": "starts_at",
      "type": "datetime"
    },
    {
      "name": "ticket_url",
      "type": "url"
    },
    {
      "name": "price",
      "type": "decimal",
      "ge": 0
    },
    {
      "name": "currency",
      "type": "string",
      "min_length": 1,
      "pattern": "^UYU$"
    }
  ],
  "sources": [
    {
      "kind": "file",
      "path": "sodre-cartelera.html",
      "url": "https://sodre.gub.uy/espectaculos/",
      "recipe": {
        "strategy": "css",
        "fields": {
          "performance_id": "::attr(data-performance-id)",
          "title": "h2.cyg--display-3::text",
          "performers": "p::text",
          "venue": "address img::attr(alt)",
          "city": "address span.cyg--ciudad::text",
          "starts_at": "time.cyg--dia::attr(datetime)",
          "ticket_url": "a.cyg--btn::attr(href)",
          "price": "span.cyg--precio::text",
          "currency": "span.cyg--moneda::text"
        },
        "record_selector": ".item .cyg--info.espectaculo",
        "require_evidence": true
      }
    },
    {
      "kind": "file",
      "path": "tickantel-evento.html",
      "url": "https://tickantel.com.uy/ng/espectaculo/9900102/gala-anual-2026-area-tango-y-milonga",
      "recipe": {
        "strategy": "jsonld",
        "fields": {
          "performance_id": "/identifier",
          "title": "/name",
          "performers": "/performer/name",
          "venue": "/location/name",
          "city": "/location/address/addressLocality",
          "starts_at": "/startDate",
          "ticket_url": "/offers/url",
          "price": "/offers/price",
          "currency": "/offers/priceCurrency"
        },
        "item_type": "Event",
        "require_evidence": true
      }
    },
    {
      "kind": "file",
      "path": "third.html",
      "url": "https://costa.example/agenda",
      "recipe": {
        "strategy": "css",
        "record_selector": ".dance",
        "fields": {
          "performance_id": "::attr(data-id)",
          "title": "h2::text",
          "performers": ".performers::text",
          "venue": ".venue::text",
          "city": ".city::text",
          "starts_at": "time::attr(datetime)",
          "ticket_url": "a::attr(href)",
          "price": ".price::text",
          "currency": ".currency::text"
        },
        "require_evidence": true
      }
    }
  ]
}
