{
  "$defs": {
    "AcquisitionUse": {
      "additionalProperties": false,
      "description": "How the source was fetched. Names and counts only; never proxy URLs or credentials.",
      "properties": {
        "challenge_solved": {
          "default": false,
          "title": "Challenge Solved",
          "type": "boolean"
        },
        "egress": {
          "default": "direct",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Egress",
          "type": "string"
        },
        "http_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "impersonate": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserFamily"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ladder": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LadderStep"
          },
          "maxItems": 16,
          "title": "Ladder",
          "type": "array"
        },
        "proxies_used": {
          "default": 0,
          "minimum": 0,
          "title": "Proxies Used",
          "type": "integer"
        },
        "proxy_rotation": {
          "default": false,
          "title": "Proxy Rotation",
          "type": "boolean"
        },
        "render": {
          "$ref": "#/$defs/RenderMode"
        },
        "robots": {
          "default": "obeyed",
          "enum": [
            "obeyed",
            "ignored",
            "overridden"
          ],
          "title": "Robots",
          "type": "string"
        },
        "start_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/LadderLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "render"
      ],
      "title": "AcquisitionUse",
      "type": "object"
    },
    "BlockKind": {
      "enum": [
        "cloud_ip_refused",
        "login_wall",
        "captcha",
        "challenge_unsolved",
        "rate_limited",
        "robots",
        "geo_blocked",
        "unknown"
      ],
      "type": "string"
    },
    "BlockedHint": {
      "additionalProperties": false,
      "description": "A site refused access; ``docs`` is a repository-relative guide anchor.",
      "properties": {
        "docs": {
          "pattern": "^docs/[a-z0-9][a-z0-9_/-]{0,120}\\.md(?:#[a-z0-9][a-z0-9-]{0,80})?$",
          "title": "Docs",
          "type": "string"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "kind": {
          "$ref": "#/$defs/BlockKind"
        }
      },
      "required": [
        "kind",
        "docs"
      ],
      "title": "BlockedHint",
      "type": "object"
    },
    "BrowserFamily": {
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge"
      ],
      "type": "string"
    },
    "Capability": {
      "enum": [
        "stealth",
        "solve_challenges",
        "proxy_rotation",
        "impersonation",
        "http3",
        "unbounded_crawl",
        "robots_ignore",
        "page_actions",
        "network_capture",
        "screenshots",
        "persistent_session",
        "real_chrome",
        "cdp",
        "solver_plugins"
      ],
      "type": "string"
    },
    "ChangeKind": {
      "enum": [
        "created",
        "updated",
        "unchanged",
        "missing",
        "uncertain"
      ],
      "title": "ChangeKind",
      "type": "string"
    },
    "ConsistencyReport": {
      "additionalProperties": false,
      "description": "Three separate indicators (QUAL-006); ``None`` means \"not assessed\", never 1.0.\n\n- ``completeness``: share of declared fields that carry a value.\n- ``structural_validity``: share of candidate records that passed validation.\n- ``semantic_confidence``: lowest confidence among assessable rules.",
      "properties": {
        "completeness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completeness"
        },
        "records": {
          "minimum": 0,
          "title": "Records",
          "type": "integer"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/RuleResult"
          },
          "title": "Results",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "semantic_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Semantic Confidence"
        },
        "structural_validity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Structural Validity"
        },
        "verdict": {
          "enum": [
            "consistent",
            "inconsistent",
            "not_assessed"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "records",
        "completeness",
        "structural_validity",
        "semantic_confidence",
        "verdict",
        "results"
      ],
      "title": "ConsistencyReport",
      "type": "object"
    },
    "CrawlNote": {
      "additionalProperties": false,
      "description": "The state of a crawl when it ended, including its checkpoint.",
      "properties": {
        "checkpoint": {
          "default": "none",
          "enum": [
            "none",
            "saved",
            "finished",
            "discarded"
          ],
          "title": "Checkpoint",
          "type": "string"
        },
        "frontier_remaining": {
          "default": 0,
          "minimum": 0,
          "title": "Frontier Remaining",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "bounded",
            "unbounded"
          ],
          "title": "Mode",
          "type": "string"
        },
        "pages_fetched": {
          "default": 0,
          "minimum": 0,
          "title": "Pages Fetched",
          "type": "integer"
        },
        "resumed": {
          "default": false,
          "title": "Resumed",
          "type": "boolean"
        },
        "stop": {
          "$ref": "#/$defs/SourceReason",
          "default": "complete"
        }
      },
      "required": [
        "mode"
      ],
      "title": "CrawlNote",
      "type": "object"
    },
    "DatasetRecordKey": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Dataset",
          "type": "string"
        },
        "identity": {
          "items": {
            "$ref": "#/$defs/IdentityValue"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Identity",
          "type": "array"
        }
      },
      "required": [
        "dataset",
        "identity"
      ],
      "title": "DatasetRecordKey",
      "type": "object"
    },
    "DiscoveryNote": {
      "additionalProperties": false,
      "description": "Where the source's pages came from and how many locations survived filtering.",
      "properties": {
        "locs_admitted": {
          "default": 0,
          "minimum": 0,
          "title": "Locs Admitted",
          "type": "integer"
        },
        "locs_filtered": {
          "default": 0,
          "minimum": 0,
          "title": "Locs Filtered",
          "type": "integer"
        },
        "locs_found": {
          "default": 0,
          "minimum": 0,
          "title": "Locs Found",
          "type": "integer"
        },
        "order": {
          "default": "document",
          "enum": [
            "document",
            "reverse",
            "lastmod"
          ],
          "title": "Order",
          "type": "string"
        },
        "seed": {
          "enum": [
            "page",
            "sitemap"
          ],
          "title": "Seed",
          "type": "string"
        }
      },
      "required": [
        "seed"
      ],
      "title": "DiscoveryNote",
      "type": "object"
    },
    "DriftAssessment": {
      "additionalProperties": false,
      "properties": {
        "risk": {
          "enum": [
            "low",
            "elevated",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "score": {
          "$ref": "#/$defs/Rate"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/DriftSignal"
          },
          "title": "Signals",
          "type": "array"
        },
        "thresholds": {
          "$ref": "#/$defs/DriftThresholds"
        },
        "verdict": {
          "enum": [
            "structural_drift",
            "extraction_failure",
            "none"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "score",
        "risk",
        "verdict",
        "signals",
        "thresholds"
      ],
      "title": "DriftAssessment",
      "type": "object"
    },
    "DriftSignal": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "title": "Baseline"
        },
        "contribution": {
          "$ref": "#/$defs/Rate"
        },
        "current": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "title": "Current"
        },
        "dataset_effect": {
          "title": "Dataset Effect",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "indicator": {
          "$ref": "#/$defs/Indicator"
        }
      },
      "required": [
        "field",
        "indicator",
        "baseline",
        "current",
        "explanation",
        "dataset_effect",
        "contribution"
      ],
      "title": "DriftSignal",
      "type": "object"
    },
    "DriftThresholds": {
      "additionalProperties": false,
      "properties": {
        "elevated": {
          "$ref": "#/$defs/Rate",
          "default": 0.2
        },
        "high": {
          "$ref": "#/$defs/Rate",
          "default": 0.5
        }
      },
      "title": "DriftThresholds",
      "type": "object"
    },
    "FieldCounts": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "maxProperties": 256,
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "type": "object"
    },
    "HttpVersion": {
      "enum": [
        "1.1",
        "2",
        "3"
      ],
      "type": "string"
    },
    "IdentityValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "Indicator": {
      "enum": [
        "selector_match_count",
        "fallback_used",
        "subtree_fingerprint",
        "field_coverage",
        "validation_failure_rate",
        "extraction_failed"
      ],
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "description": "Safe diagnostics: no input values or user-supplied validation messages.\n\n``message`` names Pydantic's error type and message (for example\n``int_parsing: Input should be a valid integer``) only for built-in types whose\nmessage cannot contain input (see ``domain.safe_messages``); custom validator\ntext is never included. It is omitted from serialized output when absent.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "record_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Index"
        }
      },
      "required": [
        "code"
      ],
      "title": "Issue",
      "type": "object"
    },
    "JobRunStatus": {
      "enum": [
        "success",
        "partial_success",
        "failed"
      ],
      "type": "string"
    },
    "JobSummary": {
      "additionalProperties": false,
      "description": "Aggregate execution metadata across all sources in one job run.",
      "properties": {
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "format_version": {
          "const": 1,
          "default": 1,
          "title": "Format Version",
          "type": "integer"
        },
        "partial": {
          "minimum": 0,
          "title": "Partial",
          "type": "integer"
        },
        "records_accepted": {
          "minimum": 0,
          "title": "Records Accepted",
          "type": "integer"
        },
        "records_rejected": {
          "minimum": 0,
          "title": "Records Rejected",
          "type": "integer"
        },
        "schema_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Fingerprint",
          "type": "string"
        },
        "source_count": {
          "minimum": 1,
          "title": "Source Count",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/JobRunStatus"
        },
        "succeeded": {
          "minimum": 0,
          "title": "Succeeded",
          "type": "integer"
        }
      },
      "required": [
        "schema_fingerprint",
        "source_count",
        "succeeded",
        "partial",
        "failed",
        "records_accepted",
        "records_rejected",
        "status"
      ],
      "title": "JobSummary",
      "type": "object"
    },
    "LadderLevel": {
      "enum": [
        "http",
        "browser",
        "stealth",
        "challenge",
        "proxy_rotation",
        "solver_plugin"
      ],
      "type": "string"
    },
    "LadderStep": {
      "additionalProperties": false,
      "description": "One attempt at one ladder level and how it ended.",
      "properties": {
        "level": {
          "$ref": "#/$defs/LadderLevel"
        },
        "outcome": {
          "enum": [
            "ok",
            "blocked",
            "failed",
            "not_granted"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "level",
        "outcome"
      ],
      "title": "LadderStep",
      "type": "object"
    },
    "LoadStatus": {
      "enum": [
        "success",
        "degraded",
        "partial_success",
        "failed",
        "storage_error"
      ],
      "type": "string"
    },
    "LoadedSource": {
      "additionalProperties": false,
      "properties": {
        "consistency": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConsistencyReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/ChangeKind"
          },
          "title": "Counts",
          "type": "object"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "next_action": {
          "anyOf": [
            {
              "const": "rastro recipe repair",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Action"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "recipe_origin": {
          "anyOf": [
            {
              "enum": [
                "job",
                "memory"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipe Origin"
        },
        "recipe_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipe Version"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Outcome"
        }
      },
      "required": [
        "source_url",
        "status",
        "counts"
      ],
      "title": "LoadedSource",
      "type": "object"
    },
    "OpenDrift": {
      "additionalProperties": false,
      "description": "An unacknowledged elevated or high drift on a successful run of one source.\n\nWhile it is open the drift baseline stays at ``baseline_run``; acknowledging it, or\npromoting a repaired recipe for the source, clears it.",
      "properties": {
        "baseline_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Run"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "risk": {
          "enum": [
            "elevated",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "score": {
          "$ref": "#/$defs/Rate"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "structural_drift",
            "extraction_failure",
            "none"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "run_id",
        "baseline_run",
        "observed_at",
        "risk",
        "score",
        "verdict"
      ],
      "title": "OpenDrift",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "success",
        "unchanged",
        "partial_success",
        "missing_data",
        "invalid_data",
        "access_restriction",
        "transient_failure",
        "permanent_failure",
        "insufficient_evidence"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Rate": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "RenderMode": {
      "enum": [
        "http",
        "browser",
        "stealth"
      ],
      "type": "string"
    },
    "RepairNote": {
      "additionalProperties": false,
      "description": "Drift and repair for the source; ``promotion_refused`` is an issue code.",
      "properties": {
        "candidate_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Version"
        },
        "decision": {
          "default": "none",
          "enum": [
            "promoted",
            "quarantined",
            "rejected",
            "none"
          ],
          "title": "Decision",
          "type": "string"
        },
        "drift": {
          "anyOf": [
            {
              "enum": [
                "none",
                "low",
                "elevated",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drift"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "origin": {
          "anyOf": [
            {
              "enum": [
                "relocation",
                "adaptive",
                "model"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "promotion_refused": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promotion Refused"
        }
      },
      "title": "RepairNote",
      "type": "object"
    },
    "RuleResult": {
      "additionalProperties": false,
      "description": "One rule's outcome. Explanations carry field names and numbers, never source values.",
      "properties": {
        "assessed": {
          "minimum": 0,
          "title": "Assessed",
          "type": "integer"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "status": {
          "$ref": "#/$defs/RuleStatus"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "violating_indices": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Violating Indices",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "field",
        "status",
        "assessed",
        "threshold",
        "explanation"
      ],
      "title": "RuleResult",
      "type": "object"
    },
    "RuleStatus": {
      "enum": [
        "passed",
        "violated",
        "not_assessable"
      ],
      "title": "RuleStatus",
      "type": "string"
    },
    "RunReport": {
      "additionalProperties": false,
      "description": "A content-free report of one ``run`` or ``load`` of one job file.",
      "properties": {
        "capabilities_used": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "title": "Capabilities Used",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "content": {
          "const": "content_free",
          "default": "content_free",
          "title": "Content",
          "type": "string"
        },
        "dataset": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset"
        },
        "exit_code": {
          "maximum": 255,
          "minimum": 0,
          "title": "Exit Code",
          "type": "integer"
        },
        "job": {
          "pattern": "^[^/\\\\\\x00-\\x1f]{1,255}$",
          "title": "Job",
          "type": "string"
        },
        "kind": {
          "enum": [
            "run",
            "load"
          ],
          "title": "Kind",
          "type": "string"
        },
        "open_drift": {
          "default": 0,
          "minimum": 0,
          "title": "Open Drift",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReport"
          },
          "maxItems": 10000,
          "title": "Sources",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunReportStatus"
        },
        "totals": {
          "$ref": "#/$defs/RunTotals"
        }
      },
      "required": [
        "kind",
        "job",
        "started_at",
        "completed_at",
        "status",
        "exit_code",
        "sources",
        "totals"
      ],
      "title": "RunReport",
      "type": "object"
    },
    "RunReportStatus": {
      "enum": [
        "success",
        "degraded",
        "partial_success",
        "failed",
        "storage_error"
      ],
      "type": "string"
    },
    "RunTotals": {
      "additionalProperties": false,
      "description": "Totals across every source of the run.",
      "properties": {
        "blocked": {
          "minimum": 0,
          "title": "Blocked",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "model_calls": {
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "pages": {
          "minimum": 0,
          "title": "Pages",
          "type": "integer"
        },
        "partial": {
          "minimum": 0,
          "title": "Partial",
          "type": "integer"
        },
        "records_accepted": {
          "minimum": 0,
          "title": "Records Accepted",
          "type": "integer"
        },
        "records_rejected": {
          "minimum": 0,
          "title": "Records Rejected",
          "type": "integer"
        },
        "repairs_without_model": {
          "minimum": 0,
          "title": "Repairs Without Model",
          "type": "integer"
        },
        "sources": {
          "minimum": 0,
          "title": "Sources",
          "type": "integer"
        },
        "succeeded": {
          "minimum": 0,
          "title": "Succeeded",
          "type": "integer"
        }
      },
      "required": [
        "sources",
        "succeeded",
        "partial",
        "failed",
        "blocked",
        "pages",
        "records_accepted",
        "records_rejected",
        "model_calls",
        "repairs_without_model"
      ],
      "title": "RunTotals",
      "type": "object"
    },
    "SourceReason": {
      "enum": [
        "complete",
        "not_modified",
        "page_cap",
        "depth_cap",
        "request_budget",
        "time_budget",
        "stopped",
        "failed",
        "blocked",
        "robots_denied",
        "invalid_data",
        "missing_data"
      ],
      "type": "string"
    },
    "SourceReport": {
      "additionalProperties": false,
      "description": "One source: where (host and path, never a query), how it ended and what it produced.",
      "properties": {
        "acquisition": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcquisitionUse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blocked": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockedHint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "crawl": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrawlNote"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "discovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscoveryNote"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fields_nulled": {
          "$ref": "#/$defs/FieldCounts"
        },
        "host": {
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9.:\\[\\]-]{0,252}[a-z0-9\\]])?$",
          "title": "Host",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "pages": {
          "default": 0,
          "minimum": 0,
          "title": "Pages",
          "type": "integer"
        },
        "path": {
          "pattern": "^/[^?#\\s]{0,2047}$",
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/SourceReason"
        },
        "records_accepted": {
          "default": 0,
          "minimum": 0,
          "title": "Records Accepted",
          "type": "integer"
        },
        "records_rejected": {
          "default": 0,
          "minimum": 0,
          "title": "Records Rejected",
          "type": "integer"
        },
        "rejected_by_code": {
          "maxProperties": 256,
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Rejected By Code",
          "type": "object"
        },
        "repair": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepairNote"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seconds": {
          "$ref": "#/$defs/SourceTiming"
        },
        "source_index": {
          "minimum": 1,
          "title": "Source Index",
          "type": "integer"
        },
        "stored": {
          "anyOf": [
            {
              "additionalProperties": {
                "minimum": 0,
                "type": "integer"
              },
              "propertyNames": {
                "$ref": "#/$defs/ChangeKind"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stored"
        }
      },
      "required": [
        "source_index",
        "host",
        "path",
        "outcome",
        "reason"
      ],
      "title": "SourceReport",
      "type": "object"
    },
    "SourceTiming": {
      "additionalProperties": false,
      "description": "Wall-clock seconds spent per stage for one source.",
      "properties": {
        "acquisition": {
          "default": 0,
          "minimum": 0,
          "title": "Acquisition",
          "type": "number"
        },
        "extraction": {
          "default": 0,
          "minimum": 0,
          "title": "Extraction",
          "type": "number"
        },
        "total": {
          "default": 0,
          "minimum": 0,
          "title": "Total",
          "type": "number"
        },
        "validation": {
          "default": 0,
          "minimum": 0,
          "title": "Validation",
          "type": "number"
        }
      },
      "title": "SourceTiming",
      "type": "object"
    },
    "StaleSource": {
      "additionalProperties": false,
      "properties": {
        "affected_keys": {
          "items": {
            "$ref": "#/$defs/DatasetRecordKey"
          },
          "title": "Affected Keys",
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "last_attempt": {
          "format": "date-time",
          "title": "Last Attempt",
          "type": "string"
        },
        "last_success": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Success"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "source_url",
        "last_success",
        "last_attempt",
        "stale",
        "affected_keys"
      ],
      "title": "StaleSource",
      "type": "object"
    }
  },
  "$id": "https://rave-vipx.github.io/rastro/schemas/job-load.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data_trust": {
      "const": "untrusted_source_data",
      "default": "untrusted_source_data",
      "title": "Data Trust",
      "type": "string"
    },
    "dataset": {
      "title": "Dataset",
      "type": "string"
    },
    "drift": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DriftAssessment"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Drift"
    },
    "job": {
      "$ref": "#/$defs/JobSummary"
    },
    "open_drift": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OpenDrift"
      },
      "title": "Open Drift",
      "type": "array"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/LoadedSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "stale_sources": {
      "items": {
        "$ref": "#/$defs/StaleSource"
      },
      "title": "Stale Sources",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/LoadStatus",
      "default": "success"
    }
  },
  "required": [
    "dataset",
    "job",
    "sources",
    "stale_sources"
  ],
  "title": "JobLoadResult",
  "type": "object"
}
