{
  "$defs": {
    "ChangeKind": {
      "enum": [
        "created",
        "updated",
        "unchanged",
        "missing",
        "uncertain"
      ],
      "title": "ChangeKind",
      "type": "string"
    },
    "DatasetRecordKey": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "title": "Dataset",
          "type": "string"
        },
        "identity": {
          "items": {
            "$ref": "#/$defs/IdentityValue"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Identity",
          "type": "array"
        }
      },
      "required": [
        "dataset",
        "identity"
      ],
      "title": "DatasetRecordKey",
      "type": "object"
    },
    "IdentityValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "JobRunStatus": {
      "enum": [
        "success",
        "partial_success",
        "failed"
      ],
      "type": "string"
    },
    "JobSummary": {
      "additionalProperties": false,
      "description": "Aggregate execution metadata across all sources in one job run.",
      "properties": {
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "format_version": {
          "const": 1,
          "default": 1,
          "title": "Format Version",
          "type": "integer"
        },
        "partial": {
          "minimum": 0,
          "title": "Partial",
          "type": "integer"
        },
        "records_accepted": {
          "minimum": 0,
          "title": "Records Accepted",
          "type": "integer"
        },
        "records_rejected": {
          "minimum": 0,
          "title": "Records Rejected",
          "type": "integer"
        },
        "schema_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Fingerprint",
          "type": "string"
        },
        "source_count": {
          "minimum": 1,
          "title": "Source Count",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/JobRunStatus"
        },
        "succeeded": {
          "minimum": 0,
          "title": "Succeeded",
          "type": "integer"
        }
      },
      "required": [
        "schema_fingerprint",
        "source_count",
        "succeeded",
        "partial",
        "failed",
        "records_accepted",
        "records_rejected",
        "status"
      ],
      "title": "JobSummary",
      "type": "object"
    },
    "LoadedSource": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/ChangeKind"
          },
          "title": "Counts",
          "type": "object"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Outcome"
        }
      },
      "required": [
        "source_url",
        "status",
        "counts"
      ],
      "title": "LoadedSource",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "success",
        "partial_success",
        "missing_data",
        "invalid_data",
        "access_restriction",
        "transient_failure",
        "permanent_failure",
        "insufficient_evidence"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "StaleSource": {
      "additionalProperties": false,
      "properties": {
        "affected_keys": {
          "items": {
            "$ref": "#/$defs/DatasetRecordKey"
          },
          "title": "Affected Keys",
          "type": "array"
        },
        "last_attempt": {
          "format": "date-time",
          "title": "Last Attempt",
          "type": "string"
        },
        "last_success": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Success"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "source_url",
        "last_success",
        "last_attempt",
        "stale",
        "affected_keys"
      ],
      "title": "StaleSource",
      "type": "object"
    }
  },
  "$id": "https://rave-vipx.github.io/rastro/schemas/job-load.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data_trust": {
      "const": "untrusted_source_data",
      "default": "untrusted_source_data",
      "title": "Data Trust",
      "type": "string"
    },
    "dataset": {
      "title": "Dataset",
      "type": "string"
    },
    "job": {
      "$ref": "#/$defs/JobSummary"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/LoadedSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "stale_sources": {
      "items": {
        "$ref": "#/$defs/StaleSource"
      },
      "title": "Stale Sources",
      "type": "array"
    }
  },
  "required": [
    "dataset",
    "job",
    "sources",
    "stale_sources"
  ],
  "title": "JobLoadResult",
  "type": "object"
}
