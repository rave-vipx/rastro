{
  "$defs": {
    "AcquisitionPolicy": {
      "additionalProperties": false,
      "description": "An exact host allowlist asserts the caller's permission to acquire a source.",
      "properties": {
        "allow_http": {
          "default": false,
          "title": "Allow Http",
          "type": "boolean"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Allowed Hosts",
          "type": "array"
        },
        "backoff_seconds": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Backoff Seconds",
          "type": "number"
        },
        "egress_profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/EgressProfile"
          },
          "maxProperties": 16,
          "title": "Egress Profiles",
          "type": "object"
        },
        "max_concurrency": {
          "default": 4,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "max_redirects": {
          "default": 5,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Redirects",
          "type": "integer"
        },
        "max_requests": {
          "default": 30,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_retries": {
          "default": 2,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "max_retry_delay_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Max Retry Delay Seconds",
          "type": "number"
        },
        "max_sources": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Sources",
          "type": "integer"
        },
        "min_interval_seconds": {
          "default": 1,
          "maximum": 60,
          "minimum": 0,
          "title": "Min Interval Seconds",
          "type": "number"
        },
        "operation_timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Operation Timeout Seconds",
          "type": "number"
        },
        "request_timeout_seconds": {
          "default": 15,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Request Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "allowed_hosts"
      ],
      "title": "AcquisitionPolicy",
      "type": "object"
    },
    "AfterObservation": {
      "additionalProperties": false,
      "description": "Datetimes of ``field`` must not lie before the observation time (minus tolerance).",
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "kind": {
          "const": "after_observation",
          "title": "Kind",
          "type": "string"
        },
        "max_violation_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "default": 0.0,
          "ge": 0,
          "le": 1,
          "title": "Max Violation Ratio"
        },
        "tolerance_minutes": {
          "default": 0,
          "maximum": 525600,
          "minimum": 0,
          "title": "Tolerance Minutes",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "field"
      ],
      "title": "AfterObservation",
      "type": "object"
    },
    "BooleanField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "const": "boolean",
          "default": "boolean",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "BooleanField",
      "type": "object"
    },
    "CommandProvider": {
      "additionalProperties": false,
      "description": "A local model command run without a shell; the prompt goes to stdin.\n\nThe command may forward page content to a hosted service, so it needs either\n``allow_remote = true`` or ``local = true``. ``env`` lists extra variable names\npassed through besides ``PATH`` and ``HOME``.",
      "properties": {
        "allow_remote": {
          "default": false,
          "title": "Allow Remote",
          "type": "boolean"
        },
        "argv": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "env": {
          "default": [],
          "items": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Env",
          "type": "array"
        },
        "json_path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}(\\.[A-Za-z0-9_-]{1,64}){0,7}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Path"
        },
        "local": {
          "default": false,
          "title": "Local",
          "type": "boolean"
        },
        "output": {
          "default": "json",
          "enum": [
            "json",
            "text"
          ],
          "title": "Output",
          "type": "string"
        },
        "provider": {
          "const": "command",
          "default": "command",
          "title": "Provider",
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 3600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        }
      },
      "required": [
        "argv"
      ],
      "title": "CommandProvider",
      "type": "object"
    },
    "ConsistencyRule": {
      "discriminator": {
        "mapping": {
          "after_observation": "#/$defs/AfterObservation",
          "distinct_ratio": "#/$defs/DistinctRatio",
          "historical_shift": "#/$defs/HistoricalShift"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AfterObservation"
        },
        {
          "$ref": "#/$defs/DistinctRatio"
        },
        {
          "$ref": "#/$defs/HistoricalShift"
        }
      ]
    },
    "CssRecipe": {
      "additionalProperties": false,
      "description": "Select HTML records with ``record_selector``; fields end in ::text or ::attr(name).",
      "properties": {
        "fallbacks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HtmlRecipe"
          },
          "maxItems": 3,
          "title": "Fallbacks",
          "type": "array"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 100,
          "minProperties": 1,
          "title": "Fields",
          "type": "object"
        },
        "record_selector": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Record Selector",
          "type": "string"
        },
        "require_evidence": {
          "default": false,
          "title": "Require Evidence",
          "type": "boolean"
        },
        "strategy": {
          "const": "css",
          "default": "css",
          "title": "Strategy",
          "type": "string"
        },
        "version": {
          "default": 1,
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "fields",
        "record_selector"
      ],
      "title": "CssRecipe",
      "type": "object"
    },
    "DatasetSpec": {
      "additionalProperties": false,
      "description": "Where approved records of a job would be stored and which fields identify a record.",
      "properties": {
        "approve": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approve"
        },
        "identity": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Identity",
          "type": "array"
        },
        "match_fields": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Fields"
        },
        "match_tolerance_minutes": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Tolerance Minutes"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "identity"
      ],
      "title": "DatasetSpec",
      "type": "object"
    },
    "DateField": {
      "additionalProperties": false,
      "properties": {
        "localized": {
          "default": false,
          "title": "Localized",
          "type": "boolean"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "const": "date",
          "default": "date",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "DateField",
      "type": "object"
    },
    "DateTimeField": {
      "additionalProperties": false,
      "properties": {
        "localized": {
          "default": false,
          "title": "Localized",
          "type": "boolean"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "const": "datetime",
          "default": "datetime",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "DateTimeField",
      "type": "object"
    },
    "DecimalField": {
      "additionalProperties": false,
      "properties": {
        "ge": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ge"
        },
        "le": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Le"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "const": "decimal",
          "default": "decimal",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "DecimalField",
      "type": "object"
    },
    "DistinctRatio": {
      "additionalProperties": false,
      "description": "Distinct values of ``field`` over record count must not fall below ``min_ratio``.",
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "kind": {
          "const": "distinct_ratio",
          "title": "Kind",
          "type": "string"
        },
        "min_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "default": 0.5,
          "gt": 0,
          "le": 1,
          "title": "Min Ratio"
        },
        "min_records": {
          "default": 3,
          "maximum": 100000,
          "minimum": 2,
          "title": "Min Records",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "field"
      ],
      "title": "DistinctRatio",
      "type": "object"
    },
    "EgressProfile": {
      "additionalProperties": false,
      "description": "One administrator-declared HTTP(S) proxy. Credentials are environment references.",
      "properties": {
        "password_env": {
          "anyOf": [
            {
              "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password Env"
        },
        "proxy_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Proxy Url",
          "type": "string"
        },
        "username_env": {
          "anyOf": [
            {
              "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username Env"
        }
      },
      "required": [
        "proxy_url"
      ],
      "title": "EgressProfile",
      "type": "object"
    },
    "FileJobSource": {
      "additionalProperties": false,
      "description": "Local HTML or JSON file source resolved within the job file's directory by default.",
      "properties": {
        "kind": {
          "const": "file",
          "default": "file",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "recipe": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "css": "#/$defs/CssRecipe",
                  "json": "#/$defs/JsonRecipe",
                  "jsonld": "#/$defs/JsonLdRecipe"
                },
                "propertyName": "strategy"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/CssRecipe"
                },
                {
                  "$ref": "#/$defs/JsonLdRecipe"
                },
                {
                  "$ref": "#/$defs/JsonRecipe"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipe"
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegionalContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "representation": {
          "$ref": "#/$defs/Representation",
          "default": "html"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "path"
      ],
      "title": "FileJobSource",
      "type": "object"
    },
    "HistoricalShift": {
      "additionalProperties": false,
      "description": "Median of ``field`` must not shift more than ``max_shift`` versus dataset history.\n\n``unit = \"days\"`` compares datetimes; ``unit = \"ratio\"`` compares numbers as\n``|current - history| / |history|``.",
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "kind": {
          "const": "historical_shift",
          "title": "Kind",
          "type": "string"
        },
        "max_shift": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "gt": 0,
          "le": 1000000,
          "title": "Max Shift"
        },
        "min_history": {
          "default": 3,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Min History",
          "type": "integer"
        },
        "unit": {
          "default": "days",
          "enum": [
            "days",
            "ratio"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "field",
        "max_shift"
      ],
      "title": "HistoricalShift",
      "type": "object"
    },
    "HtmlRecipe": {
      "discriminator": {
        "mapping": {
          "css": "#/$defs/CssRecipe",
          "jsonld": "#/$defs/JsonLdRecipe"
        },
        "propertyName": "strategy"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CssRecipe"
        },
        {
          "$ref": "#/$defs/JsonLdRecipe"
        }
      ]
    },
    "InferencePolicy": {
      "additionalProperties": false,
      "description": "Per-extraction budgets; concurrency is shared by one Rastro instance/event loop.",
      "properties": {
        "context_tokens": {
          "default": 8192,
          "maximum": 32768,
          "minimum": 512,
          "title": "Context Tokens",
          "type": "integer"
        },
        "max_calls": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Max Calls",
          "type": "integer"
        },
        "max_concurrency": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "max_context_bytes": {
          "default": 32768,
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Context Bytes",
          "type": "integer"
        },
        "max_discovery_candidates": {
          "default": 8,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Discovery Candidates",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 2048,
          "maximum": 8192,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_repair_attempts": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Repair Attempts",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 65536,
          "maximum": 1048576,
          "minimum": 1,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "InferencePolicy",
      "type": "object"
    },
    "IntegerField": {
      "additionalProperties": false,
      "properties": {
        "ge": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ge"
        },
        "le": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Le"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "const": "integer",
          "default": "integer",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "IntegerField",
      "type": "object"
    },
    "JobField": {
      "discriminator": {
        "mapping": {
          "boolean": "#/$defs/BooleanField",
          "date": "#/$defs/DateField",
          "datetime": "#/$defs/DateTimeField",
          "decimal": "#/$defs/DecimalField",
          "integer": "#/$defs/IntegerField",
          "number": "#/$defs/NumberField",
          "string": "#/$defs/StringField",
          "url": "#/$defs/UrlField"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StringField"
        },
        {
          "$ref": "#/$defs/IntegerField"
        },
        {
          "$ref": "#/$defs/NumberField"
        },
        {
          "$ref": "#/$defs/BooleanField"
        },
        {
          "$ref": "#/$defs/DecimalField"
        },
        {
          "$ref": "#/$defs/DateField"
        },
        {
          "$ref": "#/$defs/DateTimeField"
        },
        {
          "$ref": "#/$defs/UrlField"
        }
      ]
    },
    "JobModelProvider": {
      "discriminator": {
        "mapping": {
          "command": "#/$defs/CommandProvider",
          "http": "#/$defs/OpenAICompatibleProvider",
          "ollama": "#/$defs/OllamaProvider",
          "openai_compatible": "#/$defs/OpenAICompatibleProvider"
        },
        "propertyName": "provider"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/OllamaProvider"
        },
        {
          "$ref": "#/$defs/OpenAICompatibleProvider"
        },
        {
          "$ref": "#/$defs/CommandProvider"
        }
      ]
    },
    "JobSource": {
      "anyOf": [
        {
          "$ref": "#/$defs/UrlJobSource"
        },
        {
          "$ref": "#/$defs/FileJobSource"
        },
        {
          "type": "string"
        }
      ]
    },
    "JsonLdRecipe": {
      "additionalProperties": false,
      "description": "Map JSON-LD objects, optionally of one ``item_type``, with absolute JSON pointers.\n\nA field maps to one pointer or to 1..4 pointers; the first that resolves wins.",
      "properties": {
        "fallbacks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HtmlRecipe"
          },
          "maxItems": 3,
          "title": "Fallbacks",
          "type": "array"
        },
        "fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
